+import { useAtomValue } from "@effect/atom-react";
+import { enabledEnvironmentIds } from "@t3tools/client-runtime/state/connections";
+import type { EnvironmentId, ProjectId, ThreadId } from "@t3tools/contracts";
+import * as Option from "effect/Option";
+import { Atom } from "effect/reactivity";
+import { environmentCatalog } from "../connection/catalog";
+import type { EnvironmentShellState } from "@t3tools/client-runtime/state/shell";
+import { rawEnvironmentShell, hostScopeRevision } from "./shell";
+import { isObsidianEmbedded, obsidianThreadDecision, setObsidianScopeEpoch } from "../obsidianHost";
+const shellsAtom = Atom.make((get) => {
+  get(hostScopeRevision);
+  return new Map(
+    [...enabledEnvironmentIds(get(environmentCatalog.catalogValueAtom))].map(
+      (env) => [env, get(rawEnvironmentShell.stateValueAtom(env))] as const,
+    ),
+  );
+});
+const emptyShellsAtom = Atom.make<ReadonlyMap<EnvironmentId, EnvironmentShellState>>(new Map());
+export function useObsidianDraftFilter() {
+  const shells = useAtomValue(isObsidianEmbedded() ? shellsAtom : emptyShellsAtom);
+  return (session: {
+    environmentId: EnvironmentId;
+    projectId: ProjectId;
+    threadId: ThreadId;
+    worktreePath: string | null;
+  }) => {
+    if (!isObsidianEmbedded()) return true;
+    const state = shells.get(session.environmentId);
+    if (!state || state.status !== "live") return false;
+    setObsidianScopeEpoch(session.environmentId, `${state.generation}:${state.status}`);
+    const snapshot = Option.getOrNull(state.snapshot);
+    const projects = snapshot?.projects ?? [];
+    return (
+      obsidianThreadDecision(
+        session.environmentId,
+        { ...session, id: session.threadId },
+        projects,
+        [...(snapshot?.threads ?? []), ...(snapshot?.archivedThreads ?? [])],
+      ) === "included"
+    );
+  };
+}
