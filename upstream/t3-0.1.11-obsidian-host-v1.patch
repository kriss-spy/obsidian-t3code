+  "active",
+  "pinned",
+  "working",
+  "snoozed",
+  "settled",
+  "recents",
+  "search",
+  "archive",
+  "projects",
+  "routes",
+  "drafts",
+  "reconnect",
+  "side-chats",
+  "onboarding",
+];
