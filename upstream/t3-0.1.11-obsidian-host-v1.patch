+} from "./themePalette";
+import {
+  onObsidianThemeChoice,
+  setObsidianThemeFollowing,
+  writeObsidianTheme,
+} from "./obsidianThemeOwnership";
+
+const STORAGE = "t3code:obsidian-host-theme:v1";
+type RecordState = {
+  id?: string;
+  definition?: string;
+  blocked?: string | undefined;
+  requested?: { token: string; following: boolean };
+};
+export function createObsidianThemeHost(current: () => boolean) {
+  let token = "",
+    enabled = false,
+    revision = -1,
+    fingerprint = "",
+    disposed = false;
+  function read(): RecordState {
+    const raw = window.localStorage.getItem(STORAGE);
+    return raw ? JSON.parse(raw) : {};
+  }
+  function save(value: RecordState) {
+    window.localStorage.setItem(STORAGE, JSON.stringify(value));
+  }
+  const unsubscribe = onObsidianThemeChoice((themeId) => {
+    if (disposed || !current() || !token) return;
+    const record = read();
+    const owned = record.id ? getThemeDefinition(record.id) : null;
+    // Only the unchanged host-owned palette resumes following, never a matching display name.
+    enabled =
+      themeId === record.id && owned !== null && serializeThemeFile(owned) === record.definition;
+    setObsidianThemeFollowing(enabled);
+    try {
+      save({
+        ...record,
+        blocked: enabled ? undefined : token,
+        requested: { token, following: enabled },
+      });
+    } catch {
+      /* The host also receives the in-memory selection. */
+    }
+  });
+  function status() {
+    const record = read();
+    const following = record.requested?.token === token ? record.requested.following : enabled;
+    return {
+      version: 2,
+      token,
+      following,
+      requested: record.requested?.token === token,
+      suspended: !!token && !following,
+    };
+  }
