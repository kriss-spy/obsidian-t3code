@@ -0,0 +1,111 @@
+import { T } from "gt-react";
+import type { ReactNode } from "react";
+import { useAtomValue } from "@effect/atom-react";
+import { Atom } from "effect/reactivity";
+import * as Option from "effect/Option";
+import { Link, Navigate } from "@tanstack/react-router";
+import { rawEnvironmentShell, hostScopeRevision } from "../state/shell";
+import { EMPTY_SHELL_STATE } from "@t3tools/client-runtime/state/shell";
+import { useRawEnvironmentThread } from "../state/threads";
+import { useComposerDraftStore } from "../composerDraftStore";
+import {
+  obsidianThreadDecision,
+  setObsidianScopeEpoch,
+  openNormalObsidianTarget,
+} from "../obsidianHost";
+import type { ThreadRouteTarget } from "../threadRoutes";
+import { ThreadLinkPrompt } from "./promptLinks/ThreadLinkPrompt";
+
+const emptyShell = Atom.make(EMPTY_SHELL_STATE);
+export function ObsidianThreadGate({
+  target,
+  children,
+}: {
+  target: ThreadRouteTarget;
+  children: ReactNode;
+}) {
+  const scopeRevision = useAtomValue(hostScopeRevision);
+  const session = useComposerDraftStore((store) =>
+    target.kind === "draft" ? store.getDraftSession(target.draftId) : null,
+  );
+  const redirect = useComposerDraftStore((store) =>
+    target.kind === "draft" ? store.getPromotedDraftRedirect(target.draftId) : null,
+  );
+  const env =
+    target.kind === "server" ? target.threadRef.environmentId : (session?.environmentId ?? null);
+  const shell = useAtomValue(env === null ? emptyShell : rawEnvironmentShell.stateValueAtom(env));
+  const detail = useRawEnvironmentThread(
+    target.kind === "server" ? env : null,
+    target.kind === "server" ? target.threadRef.threadId : null,
+  );
+  if (env !== null) setObsidianScopeEpoch(env, `${shell.generation}:${shell.status}`);
+  if (target.kind === "draft" && session === null && redirect)
+    return <Navigate to="/$environmentId/$threadId" params={redirect} replace />;
+  if (env === null || shell.status !== "live")
+    return (
+      <p>
+        <T>Checking vault session scope…</T>
+      </p>
+    );
+  const projects = Option.getOrNull(shell.snapshot)?.projects ?? [];
+  const snapshot = Option.getOrNull(shell.snapshot);
+  const authoritativeThread =
+    target.kind === "server"
+      ? [...(snapshot?.threads ?? []), ...(snapshot?.archivedThreads ?? [])].find(
+          (t) => t.id === target.threadRef.threadId,
+        )
+      : null;
+  const thread =
+    target.kind === "server"
+      ? (authoritativeThread ??
+        (detail.status === "live" ? Option.getOrNull(detail.data)?.thread : null))
+      : session
+        ? { ...session, id: session.threadId }
+        : null;
+  const decision = thread
+    ? obsidianThreadDecision(
+        env,
+        thread,
+        projects,
+        [...(snapshot?.threads ?? []), ...(snapshot?.archivedThreads ?? [])],
+        scopeRevision,
+      )
+    : "pending";
+  if (decision === "pending")
+    return (
+      <p>
+        <T>Checking vault session scope…</T>
+      </p>
+    );
+  if (decision === "excluded")
+    return (
+      <div>
+        <p>
+          <T>This session is outside this vault.</T>
+        </p>
+        <Link to="/">
+          <T>Return to vault sessions</T>
+        </Link>
+        {target.kind === "server" ? (
+          <a
+            href={`/${encodeURIComponent(env)}/${encodeURIComponent(target.threadRef.threadId)}`}
+            onClick={(event) => {
+              event.preventDefault();
+              if (target.kind === "server")
+                void openNormalObsidianTarget(env, target.threadRef.threadId);
+            }}
+            target="_blank"
+            rel="noopener noreferrer"
+          >
+            <T>Open in the normal T3 app</T>
+          </a>
+        ) : null}
+      </div>
+    );
+  return (
+    <>
+      {target.kind === "server" ? <ThreadLinkPrompt threadRef={target.threadRef} /> : null}
+      {children}
+    </>
+  );
+}
