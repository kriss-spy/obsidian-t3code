@@ -0,0 +1,67 @@
+import { T } from "gt-react";
+import { useState } from "react";
+import { useAtomValue } from "@effect/atom-react";
+import { EnvironmentId } from "@t3tools/contracts";
+import { scopeProjectRef } from "@t3tools/client-runtime/environment";
+import { inferProjectTitleFromPath } from "@t3tools/client-runtime/state/projects";
+import { obsidianVaultSetup, obsidianScopePending } from "../obsidianHost";
+import { useEnvironmentShellStatus, hostScopeRevision } from "../state/shell";
+import { useAtomCommand } from "../state/use-atom-command";
+import { projectEnvironment } from "../state/projects";
+import { useNewThreadHandler } from "../hooks/useHandleNewThread";
+import { newProjectId } from "../lib/utils";
+import { Button } from "./ui/button";
+
+export function ObsidianVaultSetup() {
+  const vault = obsidianVaultSetup();
+  const scopeRevision = useAtomValue(hostScopeRevision);
+  const env = vault ? EnvironmentId.make(vault.environmentId) : null;
+  const status = useEnvironmentShellStatus(env);
+  const create = useAtomCommand(projectEnvironment.create);
+  const openThread = useNewThreadHandler();
+  const [busy, setBusy] = useState(false);
+  const [failed, setFailed] = useState(false);
+  if (!vault || !env || status !== "live" || obsidianScopePending(scopeRevision))
+    return (
+      <p>
+        <T>Checking vault session scope…</T>
+      </p>
+    );
+  const add = async () => {
+    if (busy) return;
+    setBusy(true);
+    setFailed(false);
+    try {
+      const projectId = newProjectId();
+      const result = await create({
+        environmentId: env,
+        input: {
+          projectId,
+          title: inferProjectTitleFromPath(vault.path),
+          workspaceRoot: vault.path,
+          createWorkspaceRootIfMissing: false,
+          defaultModelSelection: null,
+        },
+      });
+      if (result._tag === "Failure") {
+        setFailed(true);
+      } else await openThread(scopeProjectRef(env, projectId));
+    } catch {
+      setFailed(true);
+    }
+    setBusy(false);
+  };
+  return (
+    <div className="mt-4 flex flex-col items-center gap-2">
+      <code>{vault.path}</code>
+      <Button disabled={busy} onClick={() => void add()}>
+        <T>Use vault folder</T>
+      </Button>
+      {failed ? (
+        <p>
+          <T>Could not add the vault project.</T>
+        </p>
+      ) : null}
+    </div>
+  );
+}
