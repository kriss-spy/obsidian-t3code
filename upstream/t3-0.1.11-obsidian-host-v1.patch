+  return {
+    status,
+    configure(input: { token: string; revision: number; enabled: boolean; palette?: unknown }) {
+      if (
+        disposed ||
+        !current() ||
+        !input ||
+        !Number.isSafeInteger(input.revision) ||
+        input.revision <= revision ||
+        typeof input.token !== "string" ||
+        !/^[a-f0-9-]{36}$/.test(input.token)
+      )
+        throw Error("Stale or invalid theme request");
+      revision = input.revision;
+      const record = read();
+      token = input.token;
+      // A queued host update cannot undo a newer manual choice. The plugin acknowledges
+      // that choice by sending its matching state. A new token means an explicit toggle.
+      if (record.requested?.token === token && record.requested.following !== input.enabled) {
+        enabled = record.requested.following;
+        setObsidianThemeFollowing(enabled);
+        return status();
+      }
+      if (record.requested) {
+        delete record.requested;
+        save(record);
+      }
+      enabled = input.enabled && record.blocked !== token;
+      setObsidianThemeFollowing(enabled);
+      if (!enabled) return status();
+      const raw = input.palette as
+        | { version?: unknown; appearance?: unknown; colors?: unknown }
+        | undefined;
+      if (
+        !raw ||
+        raw.version !== 1 ||
+        !raw.colors ||
+        typeof raw.colors !== "object" ||
+        Object.keys(raw.colors).length !== THEME_COLOR_ROLES.length ||
+        THEME_COLOR_ROLES.some(
+          (role) => !/^#[a-f0-9]{6}$/i.test((raw.colors as Record<string, string>)[role] ?? ""),
+        )
+      )
+        throw Error("A complete opaque Obsidian palette is required");
+      const previous = getThemeSnapshot();
+      const owned = record.id ? getThemeDefinition(record.id) : null;
+      const mayUpdate = owned !== null && serializeThemeFile(owned) === record.definition;
+      // Never overwrite an installed or published theme based on its name or id alone.
+      const id = mayUpdate ? owned.id : "obsidian-" + randomUUID();
+      const theme = parseThemeFile({ ...raw, id, name: "Obsidian" });
+      const nextFingerprint = serializeThemeFile(theme);
+      if (
+        fingerprint === nextFingerprint &&
+        previous.theme === id &&
+        previous.resolvedTheme === theme.appearance &&
+        previous.appearanceMode === theme.appearance &&
+        previous.themeHalves === null
+      )
+        return status();
+      return writeObsidianTheme(() => {
+        let installed = false;
+        try {
+          if (mayUpdate) updateCustomTheme(theme);
+          else installCustomTheme(theme);
+          installed = true;
+          if (!setTheme(id) || !setAppearanceMode(theme.appearance))
+            throw Error("T3 rejected a theme preference write");
+          refreshTheme();
+          const after = getThemeSnapshot();
+          if (
+            after.theme !== id ||
+            after.resolvedTheme !== theme.appearance ||
+            after.appearanceMode !== theme.appearance ||
+            after.themeHalves !== null ||
+            THEME_COLOR_ROLES.some(
+              (role) =>
+                document.documentElement.style.getPropertyValue(getThemeColorVariable(role)) !==
+                theme.colors[role],
+            )
+          )
+            throw Error("T3 theme verification failed");
+          save({ ...record, id, definition: nextFingerprint });
+          fingerprint = nextFingerprint;
+          return status();
+        } catch (error) {
+          let restored = true;
+          if (installed) {
+            try {
+              if (mayUpdate) updateCustomTheme(owned);
+            } catch {
+              restored = false;
+            }
+          }
+          restored = setTheme(previous.theme) && restored;
+          for (const appearance of ["light", "dark"] as const)
+            if (previous.themeHalves?.[appearance])
+              restored = setThemeHalf(appearance, previous.themeHalves[appearance]) && restored;
+          restored = setAppearanceMode(previous.appearanceMode) && restored;
+          refreshTheme();
+          if (installed && !mayUpdate && getThemeSnapshot().theme !== id) {
+            try {
+              removeCustomTheme(id);
+            } catch {
+              restored = false;
+            }
+          }
+          fingerprint = "";
+          if (!restored) {
+            enabled = false;
+            setObsidianThemeFollowing(false);
+            throw Error(
+              "Theme update failed and rollback was incomplete. Theme following stopped.",
+              { cause: error },
+            );
+          }
+          throw error;
+        }
+      });
+    },
+    dispose() {
+      disposed = true;
+      enabled = false;
+      setObsidianThemeFollowing(false);
+      unsubscribe();
+    },
+  };
+}
