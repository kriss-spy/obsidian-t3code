+        if (epoch !== scopeEpoch) return;
+        for (const row of missing) {
+          decisions.set(rowKey(env, row), new Set());
+          inFlight.delete(rowKey(env, row));
+        }
+        for (const listener of listeners) listener();
+      })
+      .finally(() => {
+        if (epoch === scopeEpoch) for (const row of missing) inFlight.delete(rowKey(env, row));
+      });
+  }
+  return result;
+}
+export function scopeObsidianSnapshot<
+  P extends Project,
+  T extends Thread,
+  S extends { projects: readonly P[]; threads: readonly T[]; archivedThreads: readonly T[] },
+>(env: string, snapshot: S): S {
+  if (!embedded) return snapshot;
+  const projects = new Map(snapshot.projects.map((p) => [p.id, p]));
+  const rows: Row[] = snapshot.projects.map((p) => ({
+    id: p.id,
+    projectId: p.id,
+    workspaceRoot: p.workspaceRoot,
+    worktreePath: null,
+    kind: "project",
+  }));
+  const seen = new Map<string, T>();
+  const conflicts = new Set<string>();
+  for (const t of [...snapshot.threads, ...snapshot.archivedThreads]) {
+    const p = projects.get(t.projectId);
+    const previous = seen.get(t.id);
+    if (
+      previous &&
+      (previous.projectId !== t.projectId || previous.worktreePath !== t.worktreePath)
+    )
+      conflicts.add(t.id);
+    if (!previous) {
+      seen.set(t.id, t);
+      rows.push({
+        id: t.id,
+        projectId: t.projectId,
+        workspaceRoot: p?.workspaceRoot ?? null,
+        worktreePath: t.worktreePath,
+        kind: "thread",
+      });
+    }
+  }
+  const allowed = allowedRows(
+    env,
+    rows.filter((row) => row.kind === "project" || !conflicts.has(row.id)),
+  );
+  const threads = snapshot.threads.filter(
+    (t) => !conflicts.has(t.id) && allowed.has("thread:" + t.id),
+  );
+  const archivedThreads = snapshot.archivedThreads.filter(
+    (t) => !conflicts.has(t.id) && allowed.has("thread:" + t.id),
+  );
+  const ownerIds = new Set([...threads, ...archivedThreads].map((t) => t.projectId));
+  return {
+    ...snapshot,
+    projects: snapshot.projects.filter((p) => allowed.has("project:" + p.id) || ownerIds.has(p.id)),
+    threads,
+    archivedThreads,
+  };
+}
+export function isObsidianProjectAllowed(
+  env: string,
+  project: Project,
+  _revision?: number,
+): boolean {
+  if (!embedded) return true;
+  return allowedRows(env, [
+    {
+      id: project.id,
+      projectId: project.id,
+      workspaceRoot: project.workspaceRoot,
+      worktreePath: null,
+      kind: "project",
+    },
+  ]).has("project:" + project.id);
+}
+export function obsidianThreadDecision(
+  env: string,
+  thread: Thread,
+  projects: readonly Project[],
+  peers: readonly Thread[] = [],
+  _revision?: number,
+): "pending" | "included" | "excluded" {
+  if (!embedded) return "included";
+  if (
+    peers.some(
+      (p) =>
+        p.id === thread.id &&
+        (p.projectId !== thread.projectId || p.worktreePath !== thread.worktreePath),
+    )
+  )
+    return "excluded";
+  if (!initialized || env !== environmentId) return "excluded";
+  const project = projects.find((p) => p.id === thread.projectId);
+  const row: Row = {
+    kind: "thread",
+    id: thread.id,
+    projectId: thread.projectId,
+    workspaceRoot: project?.workspaceRoot ?? null,
+    worktreePath: thread.worktreePath,
+  };
+  allowedRows(env, [row]);
+  const answer = decisions.get(rowKey(env, row));
+  return answer === undefined
+    ? "pending"
+    : answer.has("thread:" + thread.id)
+      ? "included"
+      : "excluded";
+}
+export async function openNormalObsidianTarget(env: string, threadId: string) {
+  if (!embedded || !initialized) return;
+  await request({
+    type: "external",
+    environmentId: env,
+    path: `/${encodeURIComponent(env)}/${encodeURIComponent(threadId)}`,
+  });
+}
+export function canOpenObsidianMarkdown(env: string | null) {
+  return embedded && initialized && env === environmentId;
+}
+export async function openObsidianMarkdown(input: {
+  environmentId: string | null;
+  path: string;
+  line?: number | undefined;
+  column?: number | undefined;
+  newTab: boolean;
+}): Promise<boolean> {
+  if (
+    !embedded ||
+    !initialized ||
+    input.environmentId !== environmentId ||
+    !/\.md$/i.test(input.path) ||
+    !input.path.startsWith("/")
+  )
+    return false;
+  try {
+    return (await request({ type: "file", ...input, route: location.pathname })).handled === true;
+  } catch {
+    return false;
+  }
+}
