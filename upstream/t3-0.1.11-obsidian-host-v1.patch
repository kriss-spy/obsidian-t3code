new file mode 100644
index 000000000..fbad3deae
--- /dev/null
+++ b/apps/web/src/obsidianThemeOwnership.ts
@@ -0,0 +1,27 @@
+// Only the opt-in host subscribes. Ordinary clients keep their normal setters.
+let hostWrite = 0;
+let following = false;
+const listeners = new Set<(themeId?: string) => void>();
+export function isObsidianThemeFollowing() {
+  return following;
+}
+export function setObsidianThemeFollowing(value: boolean) {
+  following = value;
+}
+export function onObsidianThemeChoice(listener: (themeId?: string) => void) {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+export function notifyObsidianThemeChoice(themeId?: string) {
+  if (!hostWrite) for (const listener of listeners) listener(themeId);
+}
+export function writeObsidianTheme<T>(write: () => T): T {
+  hostWrite++;
+  try {
+    return write();
+  } finally {
+    hostWrite--;
+  }
+}
