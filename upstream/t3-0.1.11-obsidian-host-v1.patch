diff --git a/apps/web/src/useObsidianMarkdown.ts b/apps/web/src/useObsidianMarkdown.ts
new file mode 100644
index 000000000..bdcdb0ce6
--- /dev/null
+++ b/apps/web/src/useObsidianMarkdown.ts
@@ -0,0 +1,19 @@
+import { useEffect, useState } from "react";
+import { verifyObsidianMarkdown } from "./obsidianHost";
+
+export function useObsidianMarkdown(env: string | null, path: string | null) {
+  const [verified, setVerified] = useState<string | null>(null);
+  const key = JSON.stringify([env, path]);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- validates the native file target against the local host filesystem
+  useEffect(() => {
+    let current = true;
+    if (path)
+      void verifyObsidianMarkdown(env, path).then((ok) => {
+        if (current) setVerified(ok ? key : null);
+      });
+    return () => {
+      current = false;
+    };
+  }, [env, path, key]);
+  return verified === key;
+}
