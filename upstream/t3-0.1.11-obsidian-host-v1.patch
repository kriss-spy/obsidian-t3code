@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import {
+  isForegroundWakeup,
+  reachesConnectionSupervisor,
+  resetsRetryBackoff,
+  shouldRelistAccountAfterWakeup,
+  shouldResubscribeAfterWakeup,
+} from "./wakeups.ts";
+
+describe("embedded view activation", () => {
+  it("probes the connection without replacing live shell subscriptions", () => {
+    const reason = "application-active-check";
+    expect(isForegroundWakeup(reason)).toBe(true);
+    expect(reachesConnectionSupervisor(reason)).toBe(true);
+    expect(resetsRetryBackoff(reason)).toBe(true);
+    expect(shouldRelistAccountAfterWakeup(reason)).toBe(true);
+    expect(shouldResubscribeAfterWakeup(reason)).toBe(false);
+  });
+
+  it("preserves ordinary foreground and mobile resubscription behavior", () => {
+    for (const reason of ["application-active", "application-active-probe", "application-active-long"] as const) {
+      expect(shouldResubscribeAfterWakeup(reason)).toBe(true);
+    }
+    expect(shouldResubscribeAfterWakeup("network-changed")).toBe(false);
+    expect(reachesConnectionSupervisor("application-focused")).toBe(false);
+  });
+});
