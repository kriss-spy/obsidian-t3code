diff --git a/apps/server/src/obsidianHostProof.ts b/apps/server/src/obsidianHostProof.ts
new file mode 100644
index 000000000..cb0bb838d
--- /dev/null
+++ b/apps/server/src/obsidianHostProof.ts
@@ -0,0 +1,40 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- The proof uses the same SHA-256 format as the Electron host.
+import * as NodeCrypto from "node:crypto";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- The proof needs O_NOFOLLOW and fstat on the same descriptor.
+import * as NodeFS from "node:fs";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Validate the challenge filename synchronously before opening it.
+import * as NodePath from "node:path";
+
+export function obsidianHostProof(file: string, environmentId: string) {
+  if (!NodePath.isAbsolute(file) || !/^t3-code-host-[0-9a-f-]{36}$/.test(NodePath.basename(file)))
+    return null;
+  let fd: number | undefined;
+  try {
+    fd = NodeFS.openSync(file, NodeFS.constants.O_RDONLY | NodeFS.constants.O_NOFOLLOW);
+    const stat = NodeFS.fstatSync(fd);
+    if (
+      !stat.isFile() ||
+      stat.size !== 64 ||
+      (stat.mode & 0o777) !== 0o600 ||
+      stat.uid !== process.getuid?.()
+    )
+      return null;
+    const token = NodeFS.readFileSync(fd, "utf8");
+    if (!/^[a-f0-9]{64}$/.test(token)) return null;
+    return {
+      adapterBuild: "obsidian-host-v1.2",
+      revision: "59651c1761f6c63e9b6056839067066968e6a406",
+      environmentId,
+      machineProof: NodeCrypto.createHmac("sha256", token)
+        .update("machine:" + NodeFS.readFileSync("/etc/machine-id", "utf8").trim())
+        .digest("hex"),
+      proof: NodeCrypto.createHash("sha256")
+        .update(token + ":" + environmentId)
+        .digest("hex"),
+    };
+  } catch {
+    return null;
+  } finally {
+    if (fd !== undefined) NodeFS.closeSync(fd);
+  }
+}
